{
  "name": "mogoo-codex-status",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "mogoo",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "test": "node --test tests/*.test.mjs",
    "test:drag": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-drag.ps1",
    "test:skins": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-skins.ps1",
    "inspect": "node scripts/control.mjs inspect",
    "start": "node scripts/control.mjs start",
    "stop": "node scripts/control.mjs stop",
    "runtime:install": "node scripts/control.mjs install",
    "runtime:uninstall": "node scripts/control.mjs uninstall",
    "marketplace:sync": "node scripts/package-plugin.mjs",
    "marketplace:check": "node scripts/package-plugin.mjs --check"
  }
}
